{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "ember",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2025-09-15",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"directory": ".svelte-kit/cloudflare",
		"binding": "ASSETS"
	},
	"workers_dev": true,
	"preview_urls": true,
	"observability": {
		"enabled": true
	},
	"placement": {
		"mode": "smart"
	},
	"previews": {
		"observability": {
			"enabled": true
		}
	}
}
