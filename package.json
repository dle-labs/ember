{
	"name": "@dle.dev/ember",
	"version": "3.2.6",
	"author": {
		"name": "Daniel Einars",
		"email": "github@dle.dev"
	},
	"license": "MIT",
	"description": "Headless Svelte trees with controlled interaction and immutable tree utilities.",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/dle-labs/ember.git"
	},
	"bugs": {
		"url": "https://github.com/dle-labs/ember/issues"
	},
	"private": false,
	"homepage": "https://ember.dle.dev",
	"scripts": {
		"dev": "vite dev",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"gen:exports": "svelte-lib-helpers exports",
		"gen:docspropvalue": "svelte-lib-helpers docspropvalue polaroidkidd/ember",
		"gen:component-data-prop-value": "svelte-lib-helpers component-data-prop-value polaroidkidd/ember",
		"copy:packagejson": "svelte-lib-helpers package",
		"lib-helpers": "pnpm gen:component-data-prop-value && pnpm gen:docspropvalue && pnpm format && pnpm prepack && pnpm gen:exports && pnpm copy:packagejson && pnpm format",
		"build": "vite build && npm run prepack",
		"preview": "vite preview",
		"preview:cf": "pnpm build && wrangler pages dev ./.svelte-kit/cloudflare",
		"prepare": "svelte-kit sync && svelte-package && husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "eslint \"./src/**/*.{js,ts,svelte}\"",
		"lint:fix": "eslint \"./src/**/*.{js,ts,svelte}\" --fix",
		"test": "vitest --run",
		"test:ui": "vitest --watch",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"publish-packages": "changeset publish"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"src/lib",
		"!src/lib/**/*.test.*",
		"!src/lib/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/adapter-cloudflare": "^8.0.2",
		"@sveltejs/adapter-node": "^6.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/package": "^3.0.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/lodash-es": "^4.17.12",
		"@types/node": "^24.19.2",
		"@vitest/browser": "^5.0.5",
		"@vitest/browser-playwright": "^5.0.5",
		"@vitest/ui": "5.0.5",
		"clsx": "^2.1.1",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-svelte": "^3.23.1",
		"eslint-plugin-unused-imports": "^4.4.1",
		"eslint-plugin-yml": "^3.9.0",
		"globals": "^17.14.0",
		"highlight.js": "^11.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"lodash-es": "^4.18.1",
		"playwright": "1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"publint": "^0.3.25",
		"sass-embedded": "^1.107.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.7",
		"svelte-highlight": "^7.23.1",
		"svelte-lib-helpers": "^0.4.31",
		"tailwindcss": "^4.3.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"uuid": "^14.0.3",
		"vite": "^8.3.5",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0",
		"wrangler": "^4.156.0",
		"yaml-eslint-parser": "^2.1.0"
	},
	"keywords": [
		"svelte",
		"headless"
	],
	"packageManager": "pnpm@12.16.1",
	"engines": {
		"node": ">=24.7.0",
		"pnpm": ">=12.16.1"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"peerDependencies": {
		"svelte": "^5.57.3"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./types": {
			"types": "./dist/types.d.ts",
			"import": "./dist/types.js",
			"default": "./dist/types.js"
		},
		"./tree.svelte": {
			"types": "./dist/tree/tree.svelte.d.ts",
			"svelte": "./dist/tree/tree.svelte"
		},
		"./package.json": "./package.json",
		"./tree": {
			"types": "./dist/tree/data.d.ts",
			"import": "./dist/tree/data.js",
			"default": "./dist/tree/data.js"
		},
		"./tree-view.svelte": {
			"types": "./dist/tree/tree-view.svelte.d.ts",
			"svelte": "./dist/tree/tree-view.svelte"
		}
	},
	"imports": {
		"#lib": "./src/lib/index.ts",
		"#lib/*": "./src/lib/*"
	}
}
