{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"incremental": true,
		"tsBuildInfoFile": ".tsbuildinfo.json",
		"sourceMap": true,
		"strict": true,
		"allowSyntheticDefaultImports": true,
		"noUnusedLocals": true,
		"noImplicitReturns": true,
		"newLine": "lf",
		"preserveSymlinks": false,
		"lib": ["esnext", "DOM", "DOM.Iterable"],
		"declaration": true,
		"declarationMap": true
	},
	"include": ["src", "*.ts", "*.mts", "*.js"]
}
